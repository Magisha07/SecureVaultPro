# SecureVault SMTP configuration (Gmail recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=yourgmail@gmail.com

# Optional: set a fixed Flask session secret
# SECUREVAULT_SECRET_KEY=replace_with_random_long_secret
